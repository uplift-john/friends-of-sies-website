---
layout: layouts/base.njk
title: Contact
permalink: /contact/
description: "Get in touch with FRIENDS of SIES, or join the newsletter for updates on events and impact."
---
<header class="page-hero">
  <div class="page-hero-inner">
    <h1>Contact &amp; Newsletter</h1>
    <p class="lede">Questions, ideas, auction items, sponsorships — we'd love to hear from you.</p>
  </div>
  {% include "partials/wave-sand.njk" %}
</header>

<div class="card-duo">
<section class="card" aria-labelledby="contact-h">
  <h2 id="contact-h">Get in touch</h2>
  <p>General inquiries: <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
  <p>Advertising &amp; sponsorships: <a href="mailto:{{ site.advertisingEmail }}">{{ site.advertisingEmail }}</a></p>
</section>

<section class="card" aria-labelledby="newsletter-h">
  <h2 id="newsletter-h">Join the FRIENDS newsletter</h2>
  <p>Be first to hear about the Fun Run, the auction, and what your giving builds.</p>
  {# TODO: newsletter provider not chosen — form action is a placeholder (HUMAN_TODO.md) #}
  <form class="newsletter-form" action="#TODO-newsletter-provider" method="post">
    <label for="newsletter-email">Email address</label>
    <input type="email" id="newsletter-email" name="email" required autocomplete="email">
    <button type="submit" class="btn btn-sea">Sign up</button>
    <p class="fine-print">Signup is almost ready — while we finish setting it up, email <a href="mailto:{{ site.email }}">{{ site.email }}</a> with "newsletter" in the subject and we'll add you.</p>
  </form>
</section>
</div>



<section class="band band-sea closing-cta">
  <svg class="band-wave" viewBox="0 0 1440 70" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M0,45 C240,15 480,60 720,35 C960,10 1200,55 1440,30 L1440,0 L0,0 Z" fill="#fdfaf5"></path></svg>
  <div class="band-inner">
    <h2 class="section-title">While you're here</h2>
    <p><a class="btn btn-primary" href="/ways-to-give/">Give to Grow — Donate</a></p>
  </div>
</section>
