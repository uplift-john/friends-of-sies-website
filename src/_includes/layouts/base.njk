<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content="Eleventy">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.shortName }}</title>
  <meta name="description" content="{{ description or 'FRIENDS of Sullivan\'s Island Elementary School raises funds for the teachers, programs, and resources the district doesn\'t pay for.' }}">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="icon" href="/assets/images/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/assets/images/apple-touch-icon.png">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="site-header-inner">
      <a class="brand" href="/">
        <img class="brand-logo" src="/assets/images/logo.png" alt="FRIENDS of SIES roundel logo — Together We Are an Ocean" width="52" height="52">
        <span class="wordmark">FRIENDS<span class="wordmark-sub">of SIES</span></span>
      </a>
      <div class="header-actions">
        <a class="btn btn-nav" href="/ways-to-give/">Donate</a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav-list">
          <span class="nav-toggle-bars" aria-hidden="true"><span></span><span></span><span></span></span>
          Menu
        </button>
      </div>
      <nav class="site-nav" aria-label="Main">
        <ul id="site-nav-list">
          {% for item in nav %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </header>
  <main id="main">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="footer-inner">
      <p class="footer-name">{{ site.name }}</p>
      <p class="footer-tagline">{{ site.tagline }}</p>
      <p>Serving families across Sullivan's Island, Isle of Palms, and Mount Pleasant, South Carolina.</p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p class="footer-tax">{{ site.taxLine }}</p>
      <nav aria-label="Footer">
        <ul class="footer-nav">
          {% for item in nav %}
          <li><a href="{{ item.url }}">{{ item.title }}</a></li>
          {% endfor %}
          <li><a href="/friends-and-pta/">FRIENDS &amp; the PTA</a></li>
        </ul>
      </nav>
    </div>
  </footer>
  <script>
    (function () {
      var toggle = document.querySelector(".nav-toggle");
      var header = document.querySelector(".site-header");
      if (!toggle || !header) return;
      toggle.addEventListener("click", function () {
        var open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        header.classList.toggle("nav-open", !open);
      });
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && header.classList.contains("nav-open")) {
          toggle.setAttribute("aria-expanded", "false");
          header.classList.remove("nav-open");
          toggle.focus();
        }
      });
    })();
  </script>
</body>
</html>
